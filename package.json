{
  "name": "gymtracker",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "install:all": "npm install --prefix server && npm install --prefix web",
    "dev:server": "npm run dev --prefix server",
    "dev:web": "npm run dev --prefix web",
    "dev": "concurrently -n server,web -c blue,green \"npm:dev:server\" \"npm:dev:web\"",
    "seed": "npm run seed --prefix server",
    "build:web": "npm run build --prefix web",
    "start:server": "npm start --prefix server"
  },
  "devDependencies": {
    "concurrently": "^9.0.1"
  }
}
